{
  "name": "moraine",
  "version": "0.3.0",
  "private": true,
  "description": "Personal workspace for AI agent workflows",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "vitest run --config packs/automation/vitest.config.ts",
    "test:cron:bun": "bun --bun node_modules/vitest/vitest.mjs run --config packs/automation/vitest.config.ts tests/spawn.test.ts",
