    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.19.6"
  }
}
