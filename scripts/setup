#!/usr/bin/env bash
# Moraine — Setup
#
# Core-first workspace setup for new clones and forks.
#
# Core needs git and Python 3.11+, nothing else. Setup then:
#   - creates a workspace-local .venv and installs the Python deps
#   - asks which agent harnesses you run (detected ones are the default)
#     and installs OpenCode, at the pinned version, only if chosen+missing
#   - offers pack presets: core / recommended / everything / custom
#   - for each enabled pack, offers to install missing prerequisites —
#     every prompt shows the exact command from the pack's pack.yaml
#   - writes moraine.yaml, runs `moraine sync`, and smoke-tests the result
#
# Consent model: nothing is installed outside this workspace without a
# prompt, and every prompt shows the exact command that will run.
# Pass --yes (-y) for the non-interactive default (CI): core with the
# harnesses detected on PATH and nothing installed.

set -euo pipefail

BOLD="\033[1m"
GREEN="\033[32m"
YELLOW="\033[33m"
RED="\033[31m"
RESET="\033[0m"

info()  { echo -e "${BOLD}$*${RESET}"; }
ok()    { echo -e "${GREEN}✓ $*${RESET}"; }
warn()  { echo -e "${YELLOW}→ $*${RESET}"; }
fail()  { echo -e "${RED}✗ $*${RESET}"; echo "   Fix this, then re-run: bash scripts/setup — re-running is safe."; exit 1; }

YES=0
for arg in "$@"; do
    case "$arg" in
        -y|--yes) YES=1 ;;
        -h|--help)
            echo "Usage: bash scripts/setup [--yes]"
            echo "  --yes, -y   Non-interactive default (CI): core with the harnesses"
            echo "              detected on PATH. Nothing is installed without a prompt."
            exit 0
            ;;
        *) warn "Unknown argument: $arg (ignored)" ;;
    esac
done

ask() {
    local prompt="$1"
    local default="${2:-n}"
    if [[ "$YES" == "1" ]]; then
        [[ "$default" == "y" ]]
        return
    fi
    local choices="[y/N]"
    [[ "$default" == "y" ]] && choices="[Y/n]"
    echo -ne "${BOLD}${prompt} ${choices}${RESET} "
    local answer=""
    read -r answer || answer=""
    answer="${answer:-$default}"
    [[ "$answer" =~ ^[Yy] ]]
}

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

echo ""
info "🛠  Moraine — Setup"
echo "   ${REPO_ROOT}"
echo ""

# ── 1. Core requirements: git + Python ≥ 3.11 ────────────────

if ! command -v git &>/dev/null; then
    fail "git is required but not found. Install Xcode Command Line Tools first."
fi
ok "git"

if ! command -v python3 &>/dev/null; then
    fail "python3 is required but not found. Install Python 3.11+ from https://python.org"
fi
if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)'; then
    fail "python3 3.11+ is required; found $(python3 --version 2>&1 | awk '{print $2}')."
fi
ok "python3 $(python3 --version 2>&1 | awk '{print $2}')"

# ── 2. Python dependencies (workspace-local .venv) ───────────

VENV_DIR=".venv"
VENV_PY="$VENV_DIR/bin/python"

if [[ ! -x "$VENV_PY" ]]; then
    info "Creating ${VENV_DIR}/ (workspace-local, gitignored)..."
    if command -v uv &>/dev/null; then
        uv venv "$VENV_DIR" -q
    else
        python3 -m venv "$VENV_DIR"
    fi
fi

if [[ -f requirements.txt ]]; then
    info "Installing Python dependencies into ${VENV_DIR}/..."
    if command -v uv &>/dev/null; then
        uv pip install -r requirements.txt -q
    else
        # A venv created by uv ships without pip; bootstrap it when missing.
        "$VENV_PY" -m pip --version &>/dev/null || "$VENV_PY" -m ensurepip --default-pip &>/dev/null
        "$VENV_PY" -m pip install -q -r requirements.txt
    fi
    ok "Python dependencies installed (${VENV_DIR}/)"
fi

PYBIN="$VENV_PY"

# ── 3. Harnesses ──────────────────────────────────────────────

# Current choice, so re-running setup keeps what you already run.
CURRENT_HARNESSES="$("$PYBIN" - <<'PY'
import sys
from pathlib import Path
sys.path.insert(0, "scripts/workspace")
try:
    from manifest import load_manifests
    print(" ".join(load_manifests()[0].harnesses))
except Exception:
    print("")
PY
)"

echo ""
info "Agent harnesses"
echo "   Moraine is harness-neutral; sync wires the harnesses you pick."
HARNESSES=""
for harness in opencode claude codex; do
    default=n
    command -v "$harness" &>/dev/null && default=y
    [[ " $CURRENT_HARNESSES " == *" $harness "* ]] && default=y
    if ask "Run the '$harness' harness in this workspace?" "$default"; then
        HARNESSES+=" $harness"
    fi
done
HARNESSES="${HARNESSES# }"
[[ -n "$HARNESSES" ]] && ok "harnesses: $HARNESSES" || warn "no harness selected — sync will link skills but write no MCP config"

OPENCODE_VERSION=""
[[ -f ".opencode-version" ]] && OPENCODE_VERSION=$(tr -d '[:space:]' < .opencode-version)
[[ -z "$OPENCODE_VERSION" ]] && OPENCODE_VERSION="latest"

# OpenCode installs only when chosen and missing. bun is the installer when
# available; npm works everywhere else.
if [[ " $HARNESSES " == *" opencode "* ]] && ! command -v opencode &>/dev/null; then
    echo ""
    info "OpenCode not found."
    if command -v bun &>/dev/null; then
        OC_INSTALL="bun install -g --trust @opencode/cli@${OPENCODE_VERSION}"
    else
        OC_INSTALL="npm install -g @opencode/cli@${OPENCODE_VERSION}"
    fi
    echo "   Install command: $OC_INSTALL"
    if ask "Install OpenCode globally now?" "n"; then
        if $OC_INSTALL; then
            ok "OpenCode installed"
            if ! command -v opencode &>/dev/null; then
                warn "opencode is installed but not on PATH — reopen your shell or add its bin dir"
            fi
        else
            fail "OpenCode installation failed. Install manually: https://opencode.ai/docs/install"
        fi
    else
        warn "OpenCode skipped. Install later: $OC_INSTALL"
    fi
elif [[ " $HARNESSES " == *" opencode "* ]] && command -v opencode &>/dev/null; then
    # `opencode --version` prints e.g. "opencode v2.1.1" — keep only the number.
    INSTALLED_VERSION=$(opencode --version 2>/dev/null | sed -E 's/.*v?([0-9]+\.[0-9]+\.[0-9]+).*/\1/' || echo "unknown")
    if [[ "$OPENCODE_VERSION" != "latest" && "$INSTALLED_VERSION" != "$OPENCODE_VERSION" ]]; then
        warn "OpenCode ${INSTALLED_VERSION} installed, .opencode-version expects ${OPENCODE_VERSION}"
    else
        ok "opencode ${INSTALLED_VERSION}"
    fi
fi

# ── 4. Packs ─────────────────────────────────────────────────

echo ""
info "Packs"
echo "   Each pack is opt-in: skills, scripts, and jobs for one domain,"
echo "   described in packs/<name>/pack.yaml."

declare -a PACK_NAMES=() PACK_DESCS=()
while IFS=$'\t' read -r kind name rest; do
    [[ "$kind" == "pack" ]] || continue
    PACK_NAMES+=("$name")
    PACK_DESCS+=("$rest")
done < <("$PYBIN" - <<'PY'
import sys
sys.path.insert(0, "scripts/workspace")
from manifest import load_manifests
_, packs = load_manifests()
for name in sorted(packs):
    print("\t".join(["pack", name, packs[name].description]))
PY
)

# Currently-enabled packs, so the custom preset defaults keep what you run.
CURRENT_PACKS="$("$PYBIN" - <<'PY'
import sys
sys.path.insert(0, "scripts/workspace")
from manifest import enabled_packs, load_manifests
manifest, packs = load_manifests()
print(" ".join(sorted(enabled_packs(manifest.packs, packs))))
PY
)"

SELECTED_PACKS=""
if [[ "$YES" == "1" ]]; then
    echo "   --yes: core only. Enable packs later with: python3 scripts/moraine packs enable <name>"
else
    echo ""
    echo "   1) core          — no packs (your own skills live in packs/local)"
    echo "   2) recommended   — engineering, reflection, semble"
    echo "   3) everything    — every shipped pack"
    echo "   4) custom        — choose pack by pack"
    echo -ne "${BOLD}Preset${RESET} [2]: "
    read -r choice || choice=""
    choice="${choice:-2}"
    case "$choice" in
        1) warn "core only" ;;
        2) SELECTED_PACKS="engineering reflection semble"; ok "recommended: $SELECTED_PACKS" ;;
        3) SELECTED_PACKS="${PACK_NAMES[*]}"; ok "everything: $SELECTED_PACKS" ;;
        4)
            for i in "${!PACK_NAMES[@]}"; do
                name="${PACK_NAMES[$i]}"
                default=n
                [[ " $CURRENT_PACKS " == *" $name "* ]] && default=y
                echo ""
                echo "  ${BOLD}${name}${RESET} — ${PACK_DESCS[$i]}"
                if ask "    Enable $name?" "$default"; then
                    SELECTED_PACKS+=" $name"
                fi
            done
            SELECTED_PACKS="${SELECTED_PACKS# }"
            [[ -n "$SELECTED_PACKS" ]] && ok "custom: $SELECTED_PACKS" || warn "core only"
            ;;
        *) warn "unknown choice '$choice' — core only" ;;
    esac
fi

# ── 5. Prerequisites for the enabled packs ────────────────────
# The effective set includes each pack's `requires`; sync links those too.

PREREQ_OUTPUT="$("$PYBIN" - $SELECTED_PACKS <<'PY'
import sys
sys.path.insert(0, "scripts/workspace")
from manifest import enabled_packs, install_hint, load_manifests, missing_prereqs
_, packs = load_manifests()
selected = [name for name in sys.argv[1:] if name]
effective = enabled_packs(tuple(selected), packs)
print("EFFECTIVE " + " ".join(sorted(effective)))
for name, pack in sorted(effective.items()):
    for prereq in missing_prereqs(pack):
        hint = install_hint(prereq) or ""
        print("\t".join([name, prereq.cmd, prereq.why, hint]))
PY
)"
EFFECTIVE_PACKS="$(sed -n '1s/^EFFECTIVE //p' <<<"$PREREQ_OUTPUT")"

# Process substitution, not a pipe: the loop body prompts on stdin.
while IFS=$'\t' read -r pack cmd why hint; do
    echo ""
    warn "$pack: '$cmd' is missing ($why)"
    if [[ -n "$hint" ]]; then
        echo "   Install command: $hint"
        if ask "Run it now?" "n"; then
            if bash -c "$hint"; then
                ok "$cmd installed"
            else
                warn "$cmd install failed — install it manually, then re-run setup"
            fi
        else
            echo "   Later: $hint"
        fi
    else
        echo "   No install command in pack.yaml — install '$cmd' yourself, or keep the pack unenabled."
    fi
done < <(tail -n +2 <<<"$PREREQ_OUTPUT" | grep -v '^$')

if [[ " $EFFECTIVE_PACKS " == *" automation "* ]]; then
    echo ""
    if command -v bun &>/dev/null; then
        info "Installing the cron runner's dependencies..."
        (cd packs/automation/runner && bun install --frozen-lockfile --silent)
        ok "Cron runner dependencies installed"
    else
        warn "bun is missing — the cron runner's dependencies were not installed."
        echo "   Install bun, then: (cd packs/automation/runner && bun install --frozen-lockfile)"
    fi
fi

# ── 6. Write moraine.yaml and sync ───────────────────────────

echo ""
info "Writing moraine.yaml (harnesses: ${HARNESSES:-none}; packs: ${SELECTED_PACKS:-none})"
"$PYBIN" - "$HARNESSES" "$SELECTED_PACKS" <<'PY'
import sys
from pathlib import Path
sys.path.insert(0, "scripts/workspace")
from manifest import write_manifest
write_manifest(
    Path("moraine.yaml"),
    harnesses=sys.argv[1].split(),
    packs=sys.argv[2].split(),
)
PY

info "Running moraine sync..."
"$PYBIN" scripts/moraine sync || fail "moraine sync failed — fix moraine.yaml and re-run"

# ── 7. Repos: the second-machine path ────────────────────────

echo ""
info "Repos registry"
REPOS_CHECK="$("$PYBIN" scripts/moraine repos check)"
echo "$REPOS_CHECK"
MISSING_LINES="$(printf '%s\n' "$REPOS_CHECK" | grep 'missing:' || true)"
if [[ -n "$MISSING_LINES" ]] && ask "Clone the missing repo(s) now?" "y"; then
    "$PYBIN" scripts/moraine repos restore --yes || warn "some clones failed — run: python3 scripts/moraine repos restore"
fi

# ── 8. Smoke test ────────────────────────────────────────────

echo ""
info "Smoke test"

SMOKE_FAILED=0
SMOKE_OK=0
SMOKE_WARN=0

smoke_ok()   { ok "$@";   SMOKE_OK=$((SMOKE_OK + 1)); }
smoke_warn() { warn "$@"; SMOKE_WARN=$((SMOKE_WARN + 1)); }

if "$PYBIN" scripts/workspace/validate.py &>/dev/null; then
    smoke_ok "validate (workspace structure OK)"
else
    smoke_warn "validate.py failed — run it manually to see findings"
    SMOKE_FAILED=1
fi

if "$PYBIN" scripts/workspace/health-check.py --quick &>/dev/null; then
    smoke_ok "health-check (core tools OK)"
else
    smoke_warn "health-check failed — run it manually to see findings"
    SMOKE_FAILED=1
fi

# A model provider must be authenticated before any session can run.
# (Credential checks for other harnesses land with their support.)
if [[ " $HARNESSES " == *" opencode "* ]] && command -v opencode &>/dev/null; then
    if opencode auth list --standalone 2>/dev/null | grep -q "stored"; then
        smoke_ok "model provider credentials (opencode)"
    else
        smoke_warn "No model provider yet — run: opencode auth login"
    fi
fi

# ── 9. Done ───────────────────────────────────────────────────

echo ""
if [[ $SMOKE_FAILED -eq 0 ]]; then
    ok "Setup complete!"
else
    warn "Setup complete with warnings — see above"
fi
echo "   Smoke test: ${SMOKE_OK} passed, ${SMOKE_WARN} warning(s)"

echo ""
info "Python environment"
echo "   Python deps live in ${VENV_DIR}/ (workspace-local, gitignored)."
echo "   Workspace scripts use the venv automatically; for your own runs:"
echo "   source ${VENV_DIR}/bin/activate"

echo ""
info "Next step:"
echo "   • docs/first-session.md — a 20-minute walkthrough that proves the workspace works"
echo "   • Start your harness from the repo root; it reads AGENTS.md on startup"
echo "   • Open wiki/ as a vault in Obsidian for the human knowledge side (optional)"
echo ""
info "Featured skills (core, try these first):"
echo "   • scaffold-project — start a new project with PARA structure"
echo "   • session-handoff — wrap up a session, persist memory for next time"
echo "   • create-skill — build a new skill when you find a pattern worth automating"
echo ""
echo "   Skills auto-activate when you ask for what they do. Just describe your intent."
echo ""
