#!/bin/sh
# Pre-push hook — run tests and lint before pushing.
# Skipped if SKIP_HOOKS=1 is set.
# Deferred env: EVAL_DEPS=1 installs Python dev deps if missing.

if [ -n "$SKIP_HOOKS" ]; then
  echo "[husky] SKIP_HOOKS set — skipping pre-push checks"
  exit 0
fi

echo "[husky] Running pre-push checks..."
FAILED=0
PYTHON=python
if [ -x .venv/bin/python ]; then
  PYTHON=.venv/bin/python
  PATH="$PWD/.venv/bin:$PATH"
  export PATH
elif command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
fi

# ── Python dev deps ──────────────────────────────────────────
if [ -n "$EVAL_DEPS" ]; then
  if ! "$PYTHON" -m pytest --version >/dev/null 2>&1; then
    echo "[husky] Installing Python dev dependencies..."
    "$PYTHON" -m pip install -r requirements.txt -q
  fi
fi

# ── Python tests ─────────────────────────────────────────────
echo ""
echo "[husky] pytest..."
if "$PYTHON" -m pytest --version >/dev/null 2>&1; then
  "$PYTHON" -m pytest tests/ packs/ --tb=short -q
  if [ $? -ne 0 ]; then
    echo "[husky] ❌ pytest failed"
    FAILED=1
  fi
else
  echo "[husky] ❌ pytest not installed — run: bash scripts/setup"
  FAILED=1
fi

# ── Python lint ──────────────────────────────────────────────
echo ""
echo "[husky] ruff check (tests/ scripts/ packs/)..."
if command -v ruff >/dev/null 2>&1; then
  ruff check tests/ scripts/ packs/
  if [ $? -ne 0 ]; then
    echo "[husky] ❌ ruff check failed"
    FAILED=1
  fi
elif "$PYTHON" -m ruff --version >/dev/null 2>&1; then
  "$PYTHON" -m ruff check tests/ scripts/ packs/
  if [ $? -ne 0 ]; then
    echo "[husky] ❌ ruff check failed"
    FAILED=1
  fi
else
  echo "[husky] ❌ ruff not installed — run: bash scripts/setup"
  FAILED=1
fi

# ── TypeScript tests (vitest via bun) ────────────────────────
#
# Contributor-only: the automation pack's tests need bun and the root
# node_modules (bun install). Core users skip this hook entirely or set
# SKIP_HOOKS=1 — see the README's Verify section.
echo ""
echo "[husky] bun run test (vitest)..."
if command -v bun >/dev/null 2>&1; then
  bun run test 2>&1
  if [ $? -ne 0 ]; then
    echo "[husky] ❌ tests failed"
    FAILED=1
  fi
  bun run test:cron:bun 2>&1
  if [ $? -ne 0 ]; then
    echo "[husky] ❌ Bun process-timeout tests failed"
    FAILED=1
  fi
else
  echo "[husky] ❌ bun not installed — install it first: https://bun.sh/docs/installation"
  FAILED=1
fi

echo ""
if [ $FAILED -ne 0 ]; then
  echo "[husky] ❌ Pre-push checks failed"
  echo "[husky] To skip: SKIP_HOOKS=1 git push"
  exit 1
fi

echo "[husky] ✅ All pre-push checks passed"
exit 0
